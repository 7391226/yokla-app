# Bu dosyayı .env adıyla kopyalayıp değerleri oraya yaz. .env git'e girmez.

# Boş bırakılırsa Yokla sadece kural motoruyla çalışır.
# Doldurulursa cevapları Claude Haiku 5.5 yazar (kişisel veriler maskelenerek gönderilir).
ANTHROPIC_API_KEY=

# İsteğe bağlı: Google Search Console doğrulama kodu (boşsa etiket yazılmaz)
GOOGLE_SITE_VERIFICATION=
